<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>Reactive.Compiler</RootNamespace>
        <PackageId>Reactive.Compiler</PackageId>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!--
            NU5128: an analyzer package has no lib folder by design.
            NU5131: the models are a compile-only reference on purpose, adding them to lib/ would ship them at runtime
        -->
        <NoWarn>$(NoWarn);NU5128;NU5131</NoWarn>

        <Description>Source generators and analyzers for Reactive.</Description>
        <RepositoryUrl>https://github.com/reactive-platform/reactive-mono</RepositoryUrl>
        <PackageTags>reactive;roslyn;analyzer;source-generator</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="build/Reactive.Compiler.props" Pack="true" PackagePath="build" />
        <None Include="../Reactive.Compiler.Models/bin/$(Configuration)/netstandard2.0/Reactive.Compiler.Models.dll" Pack="true" PackagePath="ref/netstandard2.0" Visible="false" />
    </ItemGroup>

    <!-- Built for packing only, the compiler embeds the models' sources itself -->
    <ItemGroup>
        <ProjectReference Include="../Reactive.Compiler.Models/Reactive.Compiler.Models.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- 
        A very hacky fix towards dependencies. By default roslyn doesn't support referencing
        another projects from an analyzer directly, so to "bypass" it, we simply include these types inside 
        the compiler. How does this even resolve? Well, every feature is based on qualified paths rather
        than on the actual semantic types, so we're basically importing types to use them as placeholders.
        
        Feel free to open a PR or an issue if you know a better way to handle this.
    -->
    <ItemGroup>
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        
        <Compile Include="../Reactive.Compiler.Models/**/*.cs"
                 Exclude="../Reactive.Compiler.Models/obj/**;../Reactive.Compiler.Models/bin/**;../Reactive.Compiler.Models/Properties/AssemblyInfo.cs;../Reactive.Compiler.Models/AssemblyInfo.cs"
                 LinkBase="Models"
                 Visible="false" />
    </ItemGroup>
</Project>
